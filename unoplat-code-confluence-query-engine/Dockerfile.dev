# syntax=docker/dockerfile:1.7
# Development image for Tilt hot-reload workflow. Build from the repository root.
#
# - Dependencies are baked into the image first for cache reuse.
# - Runtime source and MCP config are also copied so the first `tilt up`
#   starts cleanly before any live_update sync occurs.
# - `fastapi dev` provides auto-reload for subsequent synced edits.
# - Keeps the full language toolchain (node/bun/poetry/uv/git) because the
#   query engine shells out to these tools while executing agents.
#
# Node/Bun are installed via their officially supported setup flows:
#   - Node.js: NodeSource APT repo (`setup_22.x`) — installs node, npm, npx,
#     and corepack with the correct symlink layout under /usr/bin -> /usr/lib.
#   - Bun: upstream `bun.sh/install` script with BUN_INSTALL=/usr/local.
# An earlier iteration cherry-picked individual binaries via `COPY --from=`
# from the official images, but BuildKit dereferences symlinks on
# single-file copies, which left npm/npx/corepack unable to locate their
# companion module trees (`Cannot find module './lib/corepack.cjs'`).

FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/opt/poetry/bin:/app/.venv/bin:$PATH" \
    PYTHONPATH=/app/src \
    MCP_SERVERS_CONFIG_PATH=/app/mcp-servers.json \
    BUN_INSTALL=/usr/local \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        curl \
        chromium \
        eza \
        fonts-liberation \
        fonts-noto-color-emoji \
        git \
        gnupg \
        ripgrep \
        unzip \
    && rm -rf /var/lib/apt/lists/*

# D2 with bundled ELK support. Pin and checksum the release so local
# development matches the production rendering toolchain.
ARG D2_VERSION=0.7.1
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH}" in \
        amd64) D2_SHA256="eb172adf59f38d1e5a70ab177591356754ffaf9bebb84e0ca8b767dfb421dad7" ;; \
        arm64) D2_SHA256="ce3a0b985a8f91335a826c254b3a88736fd81afcdd08b58f6c749d2add6864b0" ;; \
        *) echo "Unsupported D2 architecture: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    D2_ARCHIVE="d2-v${D2_VERSION}-linux-${TARGETARCH}.tar.gz"; \
    curl -fsSL \
        "https://github.com/d2lang/d2/releases/download/v${D2_VERSION}/${D2_ARCHIVE}" \
        -o /tmp/d2.tar.gz; \
    echo "${D2_SHA256}  /tmp/d2.tar.gz" | sha256sum --check -; \
    tar -xzf /tmp/d2.tar.gz -C /tmp; \
    install -m 0755 "/tmp/d2-v${D2_VERSION}/bin/d2" /usr/local/bin/d2; \
    rm -rf /tmp/d2.tar.gz "/tmp/d2-v${D2_VERSION}"; \
    d2 --version

# uv (package manager) and uvx
COPY --from=ghcr.io/astral-sh/uv:0.10.9 /uv /uvx /usr/local/bin/

# Poetry — needed by the agent subprocesses that verify Python workflow commands.
RUN curl -sSL https://install.python-poetry.org | POETRY_HOME=/opt/poetry python3 -

# Node.js 22 via the official NodeSource APT repository. This installs
# node/npm/npx/corepack with correct symlink layout so Corepack, pnpm, and
# yarn shims all resolve. `corepack enable` installs the pnpm/yarn launchers
# in /usr/bin.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    rm -rf /var/lib/apt/lists/* && \
    corepack enable

# Bun via the upstream installer. BUN_INSTALL=/usr/local lands the binaries
# at /usr/local/bin/bun and /usr/local/bin/bunx.
RUN curl -fsSL https://bun.sh/install | bash

# Keep the repository layout for uv's relative commons path. Tilt syncs commons
# source to this editable install. Migrations run from Dockerfile.migrator instead.
WORKDIR /workspace/unoplat-code-confluence-query-engine

# Install the dependency closure first so source edits do not invalidate it.
COPY unoplat-code-confluence-query-engine/pyproject.toml unoplat-code-confluence-query-engine/uv.lock unoplat-code-confluence-query-engine/README.md ./
COPY unoplat-code-confluence-commons/pyproject.toml unoplat-code-confluence-commons/README.md /workspace/unoplat-code-confluence-commons/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --no-install-package unoplat-code-confluence-commons

COPY unoplat-code-confluence-commons/src /workspace/unoplat-code-confluence-commons/src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project

# Copy runtime source/config so the container is bootable on the initial build.
WORKDIR /app
COPY unoplat-code-confluence-query-engine/ /app/

RUN mkdir -p /app/logs /opt/unoplat/repositories

EXPOSE 8000

# Watch src/unoplat_code_confluence_query_engine only (not .venv).
WORKDIR /app/src/unoplat_code_confluence_query_engine
CMD ["fastapi", "dev", "main.py", "--host", "0.0.0.0", "--port", "8000"]
